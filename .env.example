# Keys are optional in local demo. Never expose server secrets with a VITE_ prefix.
DEMO_MODE=true
DATABASE_URL=sqlite:./data/smart-savdo.sqlite
PORT=3001
APP_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
# Browser API URL, leave empty to use same-origin /api and Vite proxy
VITE_API_BASE_URL=
# Required, random >=32 characters when DEMO_MODE=false
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# PostgreSQL alternative: postgresql://savdo:CHANGE_ME@localhost:5432/savdo
# ADMIN_PASSWORD is only used by npm run user:create
ADMIN_PASSWORD=
