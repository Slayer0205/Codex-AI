DEMO_MODE=false
DATABASE_URL=postgresql://savdo:REPLACE_PASSWORD@localhost:5432/savdo
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_URL=https://savdo.example.com
WEB_APP_URL=https://savdo.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional webhook mode: npm start serves /telegram/webhook on the app port.
# Run npm run bot separately only for polling or a dedicated webhook process.
TELEGRAM_MODE=polling
BOT_PORT=3002
# Set 1 only behind a trusted reverse proxy, such as Render.
TRUST_PROXY=0
